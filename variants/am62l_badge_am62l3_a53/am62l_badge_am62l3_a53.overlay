#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/ti-k3-pinctrl.h>

/ {
	zephyr,user {
		digital-pin-gpios =
			<&main_gpio0 0 GPIO_ACTIVE_HIGH>,  /* D0 - UART0 RX */
			<&main_gpio0 1 GPIO_ACTIVE_HIGH>,  /* D1 - UART0 TX */
			<&main_gpio0 2 GPIO_ACTIVE_HIGH>,  /* D2 */
			<&main_gpio0 3 GPIO_ACTIVE_HIGH>,  /* D3 */
			<&main_gpio0 4 GPIO_ACTIVE_HIGH>,  /* D4 */
			<&main_gpio0 5 GPIO_ACTIVE_HIGH>,  /* D5 - LED1 */
			<&main_gpio0 6 GPIO_ACTIVE_HIGH>,  /* D6 - LED2 */
			<&main_gpio0 7 GPIO_ACTIVE_HIGH>,  /* D7 */
			<&main_gpio0 8 GPIO_ACTIVE_HIGH>,  /* D8 */
			<&main_gpio0 9 GPIO_ACTIVE_HIGH>,  /* D9 */
			<&main_gpio0 87 GPIO_ACTIVE_HIGH>, /* D10 - SPI CS */
			<&main_gpio0 91 GPIO_ACTIVE_HIGH>, /* D11 - SPI MOSI */
			<&main_gpio0 89 GPIO_ACTIVE_HIGH>, /* D12 - SPI MISO */
			<&main_gpio0 90 GPIO_ACTIVE_HIGH>; /* D13 - SPI CLK */

		builtin-led-gpios =
			<&main_gpio0 5 GPIO_ACTIVE_HIGH>,  /* LED1 */
			<&main_gpio0 6 GPIO_ACTIVE_HIGH>;  /* LED2 */

		serials = <&main_uart0>;
	};
};

&wkup_pinctrl {
	status = "okay";

	spi0_clk_default: spi0_clk_default {
		pinmux = <K3_PINMUX(0x01a8, PIN_OUTPUT, MUX_MODE_0)>; /* (E13) SPI0_CLK */
	};

	spi0_d0_default: spi0_d0_default {
		pinmux = <K3_PINMUX(0x01b0, PIN_OUTPUT, MUX_MODE_0)>; /* (B12) SPI0_D1 */
	};

	spi0_d1_default: spi0_d1_default {
		pinmux = <K3_PINMUX(0x01ac, PIN_INPUT, MUX_MODE_0)>; /* (E12) SPI0_D0 */
	};

	spi0_cs0_default: spi0_cs0_default {
		pinmux = <K3_PINMUX(0x01a0, PIN_OUTPUT, MUX_MODE_0)>; /* (E11) SPI0_CS0 */
	};

	gpio0_0_user_default: gpio0_0_user_default {
		pinmux = <K3_PINMUX(0x0000, PIN_OUTPUT, MUX_MODE_7)>; /* GPIO0_0 */
	};

	gpio0_1_user_default: gpio0_1_user_default {
		pinmux = <K3_PINMUX(0x0004, PIN_OUTPUT, MUX_MODE_7)>; /* GPIO0_1 */
	};
};

&main_uart0 {
	status = "okay";
	pinctrl-0 = <&uart0_rx_default>, <&uart0_tx_default>;
	pinctrl-names = "default";
};

&main_gpio0_0 {
	pinctrl-0 = <&dc_pins_default>, <&res_pins_default>,
		    <&busy_pins_default>, <&clk_pins_default>,
		    <&cs0_pins_default>, <&mosi_pins_default>,
		    <&btn_select_pins_default>, <&btn_left_pins_default>,
		    <&buzzer_pins_default>, <&gpio0_0_user_default>;
	pinctrl-names = "default";
	status = "okay";
};

&main_gpio0_1 {
	pinctrl-0 = <&btn_down_pins_default>, <&btn_up_pins_default>,
		    <&gpio0_1_user_default>;
	pinctrl-names = "default";
	status = "okay";
};

&main_spi0 {
	status = "okay";
	pinctrl-0 = <&spi0_clk_default>, <&spi0_d0_default>,
		    <&spi0_d1_default>, <&spi0_cs0_default>;
	pinctrl-names = "default";
};